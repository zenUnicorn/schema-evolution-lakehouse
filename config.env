# Edit PROJECT_ID, then run:  source config.env
export PROJECT_ID="your-project-id"
export REGION="us-central1"

export BUCKET_NAME="${PROJECT_ID}-schema-evo"          # table data and metadata
export DEPS_BUCKET="${PROJECT_ID}-schema-evo-deps"     # PySpark scripts and SQL files
export CATALOG_ID="schema_evo_catalog"
export NAMESPACE="shop"
export TABLE="orders"

export SPARK_RUNTIME="2.2"
export WAREHOUSE="bl://projects/${PROJECT_ID}/catalogs/${CATALOG_ID}"
export BQ_TABLE="${PROJECT_ID}.${CATALOG_ID}.${NAMESPACE}.${TABLE}"
